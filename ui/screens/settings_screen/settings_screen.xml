				<style name="item" />
				<event_cb trigger="clicked" callback="on_menu_item_clicked" user_data="0" />
			</menu_item>
			<menu_item text="舵机控制配置" icon="ic_motor_30">
				<style name="item" />
				<event_cb trigger="clicked" callback="on_menu_item_clicked" user_data="1" />
			</menu_item>
			<menu_item text="关于" icon="ic_info_30">
				<style name="item" />
				<event_cb trigger="clicked" callback="on_menu_item_clicked" user_data="2" />
			</menu_item>
		</column>
	</view>
</screen>
