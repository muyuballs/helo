<screen>
	<styles>
		<style
			name="content"
			pad_all="8"
			pad_row="8"
			flex_cross_place="start"
			flex_track_place="start"
			width="100%"
			flex_grow="1"
		/>
		<style name="sub_title" text_font="misan_16" text_color="#darkGrey" />
		<style name="radios_container" pad_column="6" width="100%" height="content" />
		<style
			name="radio_item"
			grid_column_align="stretch"
			grid_row_align="stretch"
			radius="14"
			height="32"
			flex_grow="1"
		/>
		<style
			name="micro_steps_container"
			layout="grid"
			grid_column_dsc_array="536870812,536870812,536870812"
			grid_row_dsc_array="32,32,32"
			width="100%"
			height="content"
			pad_column="6"
			pad_row="4"
		/>
	</styles>
	<view extends="column" scrollable="false">
		<style name="screen_base" />
		<event_cb callback="on_screen_loaded" trigger="screen_loaded" />
		<event_cb callback="on_stepper_driver_config_keyevent" trigger="key" />
		<toolbar title="步进驱动配置" />
		<column event_bubble="true" scrollable="true" scrollbar_mode="off">
			<style name="content" />
			<lv_label text="驱动类型">
				<style name="sub_title" />
			</lv_label>
			<row event_bubble="true" click_focusable="true">
				<style name="radios_container" />
				<radio label="TMC2209">
					<style name="radio_item" />
					<bind_state_if_eq subject="driver_type" ref_value="0" state="checked" />
				</radio>
				<radio label="A4988">
					<style name="radio_item" />
					<bind_state_if_eq subject="driver_type" ref_value="1" state="checked" />
				</radio>
			</row>
			<lv_label text="细分设置">
				<style name="sub_title" />
			</lv_label>
			<lv_obj event_bubble="true" click_focusable="true">
				<remove_style />
				<style name="micro_steps_container" />
				<radio label="1/1" style_grid_cell_row_pos="0" style_grid_cell_column_pos="0">
					<style name="radio_item" />
					<bind_state_if_eq subject="micro_steps" ref_value="0" state="checked" />
				</radio>
				<radio label="1/2" style_grid_cell_row_pos="0" style_grid_cell_column_pos="1">
					<style name="radio_item" />
					<bind_state_if_eq subject="micro_steps" ref_value="1" state="checked" />
				</radio>
				<radio label="1/4" style_grid_cell_row_pos="0" style_grid_cell_column_pos="2">
					<style name="radio_item" />
					<bind_state_if_eq subject="micro_steps" ref_value="1" state="checked" />
				</radio>
				<radio label="1/8" style_grid_cell_row_pos="1" style_grid_cell_column_pos="0">
					<style name="radio_item" />
					<bind_state_if_eq subject="micro_steps" ref_value="1" state="checked" />
				</radio>
				<radio label="1/16" style_grid_cell_row_pos="1" style_grid_cell_column_pos="1">
					<style name="radio_item" />
					<bind_state_if_eq subject="micro_steps" ref_value="1" state="checked" />
				</radio>
				<radio label="1/32" style_grid_cell_row_pos="1" style_grid_cell_column_pos="2">
					<style name="radio_item" />
					<bind_state_if_eq subject="micro_steps" ref_value="1" state="checked" />
				</radio>
				<radio label="1/64" style_grid_cell_row_pos="2" style_grid_cell_column_pos="0">
					<style name="radio_item" />
					<bind_state_if_eq subject="micro_steps" ref_value="1" state="checked" />
				</radio>
				<radio label="1/128" style_grid_cell_row_pos="2" style_grid_cell_column_pos="1">
					<style name="radio_item" />
					<bind_state_if_eq subject="micro_steps" ref_value="1" state="checked" />
				</radio>
				<radio label="1/256" style_grid_cell_row_pos="2" style_grid_cell_column_pos="2">
					<style name="radio_item" />
					<bind_state_if_eq subject="micro_steps" ref_value="1" state="checked" />
				</radio>
			</lv_obj>
			<lv_label text="旋转方向">
				<style name="sub_title" />
			</lv_label>
			<row event_bubble="true" click_focusable="true">
				<style name="radios_container" />
				<radio label="CW">
					<style name="radio_item" />
					<bind_state_if_eq subject="rotate_dir" ref_value="0" state="checked" />
				</radio>
				<radio label="CCW">
					<style name="radio_item" />
					<bind_state_if_eq subject="rotate_dir" ref_value="1" state="checked" />
				</radio>
			</row>
		</column>
	</view>
</screen>
