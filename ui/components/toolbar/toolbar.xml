<component>
	<previews>
		<preview width="240" height="240" style_bg_color="0xeee" />
	</previews>

	<api>
		<prop name="title" type="string" default="SETTINGS" />
		<prop name="height" type="int" default="32" />
	</api>

	<styles>
		<style
			flex_main_place="center"
			pad_column="4"
			flex_cross_place="center"
			flex_track_place="center"
			name="toolbar_style"
			text_color="#white"
			text_font="misan_16"
			bg_opa="45%"
			bg_color="0x11161b"
			height="32"
			width="100%"
		/>
	</styles>

	<view extends="row" height="$height">
		<style name="toolbar_style" />
		<lv_label text="$title" />
	</view>
</component>
