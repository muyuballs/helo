<component>
	<previews>
		<preview width="320" height="240" style_bg_color="0xfff" />
	</previews>

	<api>
		<prop name="text" type="string" default="menu item" />
		<prop name="has_sub" type="bool" default="true" />
	</api>

	<styles>
		<style
			name="style_base"
			border_side="none"
			radius="3"
			pad_all="3"
			width="100%"
			border_color="#darkGrey"
			text_color="#black"
			flex_cross_place="center"
			flex_track_place="center"
		/>
		<style name="dot" opa="0" margin_right="8" bg_opa="255" bg_color="#active" radius="12" width="12" height="12" />
		<style name="selected" text_color="#active" />
		<style name="style_title" text_font="misan_16" />
	</styles>

	<view extends="row" clickable="true">
		<style name="style_base" />
		<style name="selected" selector="focused" />
		<event_cb trigger="focused" callback="on_menu_item_focus_changed" />
		<lv_obj name="prefix">
			<remove_style />
			<style name="dot" />
		</lv_obj>
		<lv_label text="$text">
			<style name="style_title" />
		</lv_label>
	</view>
</component>
