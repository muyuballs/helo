<component>
	<previews>
		<preview width="320" height="240" style_bg_color="0x000" />
	</previews>

	<api>
		<prop name="text" type="string" default="menu item" />
		<prop name="has_sub" type="bool" default="true" />
	</api>

	<styles>
		<style
			name="style_base"
			shadow_color="#grey"
			shadow_width="2"
			border_width="1"
			radius="3"
			pad_all="3"
			width="100%"
			border_color="#darkGrey"
			flex_main_place="space_between"
		/>
		<style name="selected" border_color="#active" />
		<style name="style_title" text_color="#black" />
	</styles>

	<view extends="row" click_focusable="true">
		<style name="style_base" />
		<style name="selected" selector="focused" />
		<lv_label text="$text">
			<style name="style_title" />
		</lv_label>
	</view>
</component>
