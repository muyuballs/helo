<component>
	<previews>
		<preview width="224" height="69" style_bg_color="0xff0000" />
	</previews>

	<api>
		<prop name="text" type="string" default="menu item" />
		<prop name="icon" type="image" default="ic_info_30" />
	</api>

	<styles>
		<style
			name="style_base"
			border_width="2"
			border_color="#active"
			border_side="none"
			radius="3"
			pad_left="12"
			pad_right="4"
			width="100%"
			height="69"
			bg_image_src="mitem_bg"
			flex_cross_place="center"
			flex_track_place="center"
		/>
		<style name="selected" border_side="full" />
		<style
			name="title_style"
			text_color="#white"
			flex_grow="1"
			text_font="misan_22"
			pad_hor="12"
			text_align="left"
		/>
		<style name="icon_style" width="30" height="30" />
	</styles>

	<view extends="row" clickable="true" scrollable="false">
		<style name="style_base" />
		<style name="selected" selector="focused" />
		<event_cb trigger="focused" callback="on_menu_item_focus_changed" />
		<lv_image src="$icon">
			<style name="icon_style" />
		</lv_image>
		<lv_label text="$text">
			<style name="title_style" />
		</lv_label>
		<lv_image src="ic_more_24" />
	</view>
</component>
