<component>
	<previews>
		<preview width="240" height="240" style_bg_image_src="main_bg" style_bg_color="0xeee" />
	</previews>

	<api>
		<prop name="label" type="string" default="RADIO" />
	</api>

	<styles>
		<style
			name="radio_base"
			text_color="0xE0E0E0"
			border_opa="255"
			bg_opa="70"
			border_width="2"
			bg_color="0x6688ee"
			radius="255"
		/>
		<style name="radio_focused" text_color="0xFFFFFF" shadow_width="10" border_opa="255" border_color="0x00D1FF" />
		<style name="radio_checked" text_color="0x1A1C22" bg_opa="255" bg_grad_color="0xE0E0E0" />
		<style name="radio_label" align="center" text_font="misan_16" />
	</styles>

	<view extends="lv_obj" focused="false" checked="false" clickable="true" click_focusable="true" checkable="true">
		<remove_style />
		<style name="radio_base" />
		<style name="radio_checked" selector="checked" />
		<style name="radio_focused" selector="focused" />
		<lv_label text="$label">
			<style name="radio_label" />
		</lv_label>
	</view>
</component>
