.program st7789_drv
.side_set 1

; 极简 8 位串行发送器
; 时钟在 side-set 引脚，数据在 out 引脚
.wrap_target
    out pins, 1   side 0 ; 弹出 1 bit 数据，时钟拉低
    nop           side 1 ; 时钟拉高（维持 1 周期）
.wrap

% c-sdk {
static inline void st7789_drv_program_init(PIO pio, uint sm, uint offset, uint data_pin, uint clk_pin, float clk_div) {
    pio_gpio_init(pio, data_pin);
    pio_gpio_init(pio, clk_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, data_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, clk_pin, 1, true);

    pio_sm_config c = st7789_drv_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, clk_pin);
    sm_config_set_out_pins(&c, data_pin, 1);
    
    // 合并 FIFO，将 TX FIFO 深度扩充至 8
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    
    // MSB First, 开启自动拉取(autopull), 阈值 8 位
    sm_config_set_out_shift(&c, false, true, 8);
    sm_config_set_clkdiv(&c, clk_div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

static inline void st7789_drv_put(PIO pio, uint sm, uint8_t x) {
    while (pio_sm_is_tx_fifo_full(pio, sm));
    *(volatile uint8_t*)&pio->txf[sm] = x;
}

// SM is done when it stalls on an empty FIFO

static inline void st7789_drv_wait_idle(PIO pio, uint sm) {
    uint32_t sm_stall_mask = 1u << (sm + PIO_FDEBUG_TXSTALL_LSB);
    pio->fdebug = sm_stall_mask;
    while (!(pio->fdebug & sm_stall_mask));
}

%}